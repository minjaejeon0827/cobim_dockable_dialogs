<Page x:Class="CobimDockableDialogs.Views.Pages.DockableDialogs.Project.CDE.Explorer.ExplorerV"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CobimDockableDialogs.Views.Pages.DockableDialogs.Project.CDE.Explorer"
      xmlns:vm="clr-namespace:CobimDockableDialogs.ViewModels.Pages.DockableDialogs.Project.CDE.Explorer"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800"
      d:DataContext="{d:DesignInstance vm:ExplorerVM}"
      Title="COBIM 탐색기" 
      Height="500" 
      Width="200"
      x:Name="DockableDialogs" 
      Background="LightGray">
    <!--  TODO : 화면 뷰 "ExplorerV.xaml"에 뷰모델 "ExplorerVM.cs"을 바인딩할 수 있도록 <Page.DataContext> 사용 (2024.08.20 jbh) -->
    <!--  참고 URL - https://www.technical-recipes.com/2015/wpf-binding-image-using-xaml-and-mvvm-pattern/  -->
    <Page.DataContext>
        <vm:ExplorerVM />
    </Page.DataContext>
    
    <Grid>
        <TextBlock Text="탐색기 DockableDialog 구현 예정..." 
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
    </Grid>
</Page>
