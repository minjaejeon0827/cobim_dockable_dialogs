<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  { StackResource } {DynamicResource }의 차이는 {StackResource }는 컴파일 실행할 때, 해당 솔루션의 존재하는 다른 로직(소스파일)에서  -->
    <!--  구현된 Resources(자원)들을 가져오는 기능이고, {DynamicResource }는 컴파일 실행 후, 프로그램이 정상 실행되는 런타임 동안에  -->
    <!--  실시간으로 데이터가 바뀌거나 화면이 새로 랜더링 되는(화면 변환) 동안에 동적으로 그때마다 필요한 Resource(자원)들을 가져오는 기능이다. -->

    <!--  테마 "봄" 전용 색상 상수화 선언  -->
    <!--  BorderBrush, Background, Foreground  전용 색상 상수화(SolidColorBrush) 선언  -->
    <!--  <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green" Color="Green"   />  -->
    <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green.10" Color="#46C35F" />
    <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green.20" Color="#09AA5C" />
    <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green.30" Color="#2E8B57" />
    <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green.40" Color="#228B22" />
    <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green.50" Color="#008000" />
    <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green.60" Color="#006400" />
    <SolidColorBrush x:Key="App.Brush.Themes.Spring.Green.90" Color="#0A3711" />

    <!--  <Color x:Key="App.Color.Themes.Spring.Green">Green</Color>  -->
    <Color x:Key="App.Color.Themes.Spring.Green.10">#46C35F</Color>
    <Color x:Key="App.Color.Themes.Spring.Green.20">#09AA5C</Color>
    <Color x:Key="App.Color.Themes.Spring.Green.30">#2E8B57</Color>
    <Color x:Key="App.Color.Themes.Spring.Green.40">#228B22</Color>
    <Color x:Key="App.Color.Themes.Spring.Green.50">#008000</Color>
    <Color x:Key="App.Color.Themes.Spring.Green.60">#006400</Color>
    <Color x:Key="App.Color.Themes.Spring.Green.90">#0A3711</Color>
</ResourceDictionary>