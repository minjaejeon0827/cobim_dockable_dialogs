<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  { StackResource } {DynamicResource }의 차이는 {StackResource }는 컴파일 실행할 때, 해당 솔루션의 존재하는 다른 로직(소스파일)에서  -->
    <!--  구현된 Resources(자원)들을 가져오는 기능이고, {DynamicResource }는 컴파일 실행 후, 프로그램이 정상 실행되는 런타임 동안에  -->
    <!--  실시간으로 데이터가 바뀌거나 화면이 새로 랜더링 되는(화면 변환) 동안에 동적으로 그때마다 필요한 Resource(자원)들을 가져오는 기능이다. -->

    <!--  테마 "여름" 전용 색상 상수화 선언  -->
    <!--  BorderBrush, Background, Foreground  전용 색상 상수화(SolidColorBrush) 선언  -->
    <SolidColorBrush x:Key="App.Brush.Themes.Summer.Navy.10" Color="#E7E8ED" />
    <SolidColorBrush x:Key="App.Brush.Themes.Summer.Navy.30" Color="#DEDFE5" />
    <SolidColorBrush x:Key="App.Brush.Themes.Summer.Navy.90" Color="#27314A" />
    <SolidColorBrush x:Key="App.Brush.Themes.Summer.Navy.100" Color="#1A2031" />

    <Color x:Key="App.Theme.Summer.Navy.10">#E7E8ED</Color>
    <Color x:Key="App.Theme.Summer.Navy.30">#DEDFE5</Color>
    <Color x:Key="App.Theme.Summer.Navy.90">#27314A</Color>
    <Color x:Key="App.Theme.Summer.Navy.100">#1A2031</Color>
</ResourceDictionary>