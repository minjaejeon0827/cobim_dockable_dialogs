<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  리소스 사전 파일 병합(MergedDictionaries) 처리  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Spring/All.xaml" />
        <ResourceDictionary Source="Summer/All.xaml" />
        <ResourceDictionary Source="Fall/All.xaml"   />
        <ResourceDictionary Source="Winter/All.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  테마 "공통" 색상 상수화 선언  -->
    <!--  BorderBrush, Background, Foreground  전용 색상 상수화(SolidColorBrush) 선언  -->
    <SolidColorBrush x:Key="App.Brush.Themes.Common.Transparent" Color="Transparent"  />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.White" Color="#FFFFFF"       />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.NavajoWhite" Color="#FFDEAD" />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.Orange.10" Color="#FF7E00"   />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.Orange.30" Color="#FF9500"   />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.Blue" Color="#556EE6"        />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.LightGray" Color="LightGray" />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.Gray" Color="Gray"           />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.DarkGray" Color="DarkGray"   />
    <SolidColorBrush x:Key="App.Brush.Themes.Common.Black" Color="Black"   />

    <Color x:Key="App.Color.Themes.Common.Transparent">Transparent</Color>
    <Color x:Key="App.Color.Themes.Common.White">#FFFFFF</Color>
    <Color x:Key="App.Color.Themes.Common.NavajoWhite">#FFDEAD</Color>
    <Color x:Key="App.Color.Themes.Common.Orange.10">#FF7E00</Color>
    <Color x:Key="App.Color.Themes.Common.Orange.30">#FF9500</Color>
    <Color x:Key="App.Color.Themes.Common.Blue">#556EE6</Color>
    <Color x:Key="App.Color.Themes.Common.LightGray">LightGray</Color>
    <Color x:Key="App.Color.Themes.Common.Gray">Gray</Color>
    <Color x:Key="App.Color.Themes.Common.DarkGray">DarkGray</Color>
    <Color x:Key="App.Color.Themes.Common.Black">Black</Color>
</ResourceDictionary>